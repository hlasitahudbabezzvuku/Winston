### Engine ###
##############

engine::init ()
{
    echo "TODO"
}

engine::update ()
{
    echo "TODO"
}

engine::clean ()
{
    echo "TODO"
}


############
### Main ###
############

declare -Ar ACTIONS=(
    ["init"]="engine::init"
    ["update"]="engine::update"
    ["clean"]="engine::clean"
)


main::main ()
{
    printf 'Winston version %s\n' "${WINSTON_VERSION}"

    for dep in "${REQUIRED_DEPS[@]}"; do
        if ! type -p "${dep}" &> /dev/null; then
            log::error "[ERROR]: Could not find \"%s\"" "${dep}" 1>&2
        fi
    done

    for (( i = 1; i - 1 < "${#}"; i++ )); do
        case "${!i}" in
            '--version' | '-v')
                printf 'Bash version %s\n' "${BASH_VERSINFO[*]}"
                exit 0
                ;;
            '--nocolor')
                declare -g WINSTON_NOCOLOR="true"
                ;;
            *)
                log::error "Unknown option ${!i}"
                ;;
        esac
    done
}

main::main "${@}"
