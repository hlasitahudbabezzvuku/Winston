############
### Main ###
############

declare -Ar ACTIONS=(
    ["list"]="engine::list"
)


main::main ()
{
    printf 'Winston version %s\n' "${WINSTON_VERSION}"

    if [[ $EUID -eq 0 ]]; then
        log::error "This script shouldn't be run as root"
    fi

    for dep in "${REQUIRED_DEPS[@]}"; do
        if ! type -p "${dep}" &> /dev/null; then
            log::error "[ERROR]: Could not find \"%s\"" "${dep}" 1>&2
        fi
    done

    declare action
    for (( i = 1; i - 1 < "${#}"; i++ )); do
        case "${!i}" in
            '--version' | '-v')
                printf 'Bash version %s\n' "${BASH_VERSINFO[*]}"
                exit 0
                ;;
            '--help')
                # TODO
                ;;
            '--nocolor')
                declare -g WINSTON_NOCOLOR="true"
                ;;
            -*)
                log::error "Unknown option ${!i}"
                ;;
            *)
                if [[ -z "${action:-}" ]]; then
                    action="${!i}"
                else
                    log::error "Multiple actions provided: ${action} and ${!i}"
                fi
                ;;
        esac
    done

    if [[ -n "${action:-}" ]]; then
        if [[ -v ACTIONS[${action}] ]]; then
            "${ACTIONS[${action}]}"
        else
            log::error "Invalid action: ${action}. Valid actions are: ${!ACTIONS[*]}"
        fi
    else
        log::error "No action provided. Please specify one of: ${!ACTIONS[*]}"
    fi
}

main::main "${@}"
