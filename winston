set -euo pipefail
export LC_ALL=C

if [[ ! "${BASH_VERSINFO[0]}" -ge 5 ]]; then
    printf 'FATAL: This script requires BASH version 5 and later. Your version is "%i"\n' "${BASH_VERSINFO[0]}" 1>&2
    exit 1
fi


##############
### Config ###
##############

declare -r WINSTON_VERSION="2026.04.28"
declare -g WINSTON_NOCOLOR=false

declare -ar REQUIRED_DEPS=(
    "bash"
    "dnf5"
    "run0"
    "grep"
    "sed"
)


###########
### Log ###
###########

log::_color ()
{
    [[ "${WINSTON_NOCOLOR}" == false ]] && printf '\033[1;3%im' "${1}"
}

log::_reset ()
{
    [[ "${WINSTON_NOCOLOR}" == false ]] && printf '\033[0m'
}

log::_print ()
{
    printf '[%s%s%s]: %s\n' "$( log::_color "${2}" )" "${1}" "$( log::_reset )" "${3}" 1>&2
}

log::info ()
{
    log::_print "INFO" 4 "${1}"
}

log::warn ()
{
    log::_print "WARNING" 3 "${1}"
}


log::error ()
{
    log::_print "ERROR" 1 "${1}"
    exit 1
}

log::trace ()
{
    printf '[%sTRACE%s]: Printing stack trace:\n' "$( tput setaf 2 )" "$( tput sgr0 )" 1>&2

    for ((i = 0; i < ${#FUNCNAME[@]} - 2; i++)); do
        printf 'Error in function %s at line %s\n' "${FUNCNAME[i + 1]}()" "${BASH_LINENO[i]}" 1>&2
    done

    unset dep
}


################
### Anaconda ###
################

anaconda::_get_config_raw ()
{
    declare KS_PATH
    declare KS_RAW

    # Check for locations
    if [[ -f "${HOME}/anaconda-ks.cfg" ]]; then
        KS_PATH="${HOME}/anaconda-ks.cfg"
    else
        KS_PATH="/root/anaconda-ks.cfg"
    fi

    # Check for write permission
    if [[ -r "${KS_PATH}" ]]; then
        KS_RAW=$( cat "${KS_PATH}" )
    else
        KS_RAW=$( run0 cat "${KS_PATH}" )
    fi

    printf "%s" "$KS_RAW"
}

